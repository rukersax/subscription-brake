# ==============================================================================
# SUBSCRIPTION BRAKE - BACKEND ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# Global development flag (When True, mocks external exchange rates, AI, and notifications)
DEVELOPMENT_MODE=True
APP_ENV=development
LOG_LEVEL=INFO

# Database Connection (AsyncPG for Postgres or aiosqlite for local testing)
DATABASE_URL=sqlite+aiosqlite:///./subscription_brake.db

# Fernet Key for AES-256 Symmetric Encryption of Tokens and Sensitive Data
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_SECRET_KEY=wG2eWJpX2o103hQJk74h0918LgTz6vB8pMnNq5X1_ZY=

# JWT Authentication Config
JWT_SECRET_KEY=change_this_to_a_super_secret_high_entropy_random_string_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Third-party Integrations (Mocked in DEVELOPMENT_MODE)
EXCHANGE_RATE_API_KEY=mock_exchange_rate_key
GEMINI_API_KEY=mock_gemini_api_key
