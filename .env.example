# ==============================================================================
# SUBSCRIPTION BRAKE - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions: Copy this file to .env and configure the secrets appropriately.
# NEVER commit the actual .env file to version control.

# --- GLOBAL DEV & SECURITY SETTINGS ---
# Set to True during development to mock external APIs (Exchange rates, Push alerts, LLM)
DEVELOPMENT_MODE=True
APP_ENV=development
LOG_LEVEL=INFO

# --- DATABASE CONFIGURATION ---
# PostgreSQL async connection string (e.g. postgresql+asyncpg://user:password@localhost:5432/subscription_brake)
# SQLite async fallback for local zero-dependency testing: sqlite+aiosqlite:///./subscription_brake.db
DATABASE_URL=sqlite+aiosqlite:///./subscription_brake.db

# --- SECURITY & ENCRYPTION SECRETS ---
# Generate Fernet key via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_SECRET_KEY=wG2eWJpX2o103hQJk74h0918LgTz6vB8pMnNq5X1_ZY=
# JWT Signing secret
JWT_SECRET_KEY=change_this_to_a_super_secret_high_entropy_random_string_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- FUTURE / PHASE 2 INTEGRATIONS ---
# Exchange Rate API (Mocked in DEVELOPMENT_MODE)
EXCHANGE_RATE_API_KEY=mock_exchange_rate_key
# Google Gemini 1.5 Flash API Key for alternative suggestions (Mocked in DEVELOPMENT_MODE)
GEMINI_API_KEY=mock_gemini_api_key
